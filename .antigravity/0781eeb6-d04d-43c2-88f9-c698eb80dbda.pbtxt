    instruction: "Update ServicesSection.tsx for Sophisticated Dark theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <section id=\"services\" className=\"py-20 bg-[#ECE8DD]/60 border-y border-[#0D1E38]/10 relative\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6\">\n          <div className=\"max-w-xl space-y-3\">\n            <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#9B2C2C] tracking-widest\">\n              <span className=\"w-6 h-[1.5px] bg-[#9B2C2C]\"></span>\n              <span>Comprehensive Portfolio</span>\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#0D1E38] tracking-tight\">\n              Ten services. One point of contact.\n            </h2>\n            <p className=\"text-sm sm:text-base text-[#3A4354] leading-relaxed\">\n              Every registration, monthly return, and statutory audit your enterprise requires \342\200\224 prepared, verified, and submitted by Sajid Tax Consultant in Opera House, Mumbai.\n            </p>\n          </div>\n\n          {/* Quick Search */}\n          <div className=\"relative w-full md:w-72\">\n            <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search service (e.g. GST, ITR, PF, Gumasta)...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-4 py-2.5 bg-white border border-[#0D1E38]/20 rounded text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#0D1E38] transition-all\"\n            />\n          </div>\n        </div>\n\n        {/* Category Filters */}\n        <div className=\"flex flex-wrap gap-2 pb-8 border-b border-[#0D1E38]/10 text-xs font-medium\">\n          <button\n            onClick={() => setActiveCategory(\'all\')}\n            className={`px-4 py-2 rounded font-mono uppercase tracking-wider transition-all ${\n              activeCategory === \'all\'\n                ? \'bg-[#0D1E38] text-white shadow-sm\'\n                : \'bg-white/80 text-gray-700 hover:bg-white\'\n            }`}\n          >\n            All 10 Services\n          </button>\n          <button\n            onClick={() => setActiveCategory(\'tax\')}\n            className={`px-4 py-2 rounded font-mono uppercase tracking-wider transition-all ${\n              activeCategory === \'tax\'\n                ? \'bg-[#9B2C2C] text-white shadow-sm\'\n                : \'bg-white/80 text-gray-700 hover:bg-white\'\n            }`}\n          >\n            Taxation &amp; GST ({SERVICES_LIST.filter(s => s.category === \'tax\').length})\n          </button>\n          <button\n            onClick={() => setActiveCategory(\'accounting\')}\n            className={`px-4 py-2 rounded font-mono uppercase tracking-wider transition-all ${\n              activeCategory === \'accounting\'\n                ? \'bg-[#0D1E38] text-white shadow-sm\'\n                : \'bg-white/80 text-gray-700 hover:bg-white\'\n            }`}\n          >\n            Accounting &amp; Audit ({SERVICES_LIST.filter(s => s.category === \'accounting\').length})\n          </button>\n          <button\n            onClick={() => setActiveCategory(\'registration\')}\n            className={`px-4 py-2 rounded font-mono uppercase tracking-wider transition-all ${\n              activeCategory === \'registration\'\n                ? \'bg-[#195E3E] text-white shadow-sm\'\n                : \'bg-white/80 text-gray-700 hover:bg-white\'\n            }`}\n          >\n            Company &amp; Licences ({SERVICES_LIST.filter(s => s.category === \'registration\').length})\n          </button>\n          <button\n            onClick={() => setActiveCategory(\'compliance\')}\n            className={`px-4 py-2 rounded font-mono uppercase tracking-wider transition-all ${\n              activeCategory === \'compliance\'\n                ? \'bg-[#195E3E] text-white shadow-sm\'\n                : \'bg-white/80 text-gray-700 hover:bg-white\'\n            }`}\n          >\n            PF &amp; Labour ({SERVICES_LIST.filter(s => s.category === \'compliance\').length})\n          </button>\n        </div>\n\n        {/* Services Grid (Clean 2-row/5-col or responsive masonry) */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 pt-8\">\n          {filteredServices.map((service) => {\n            const Icon = serviceIcons[service.id] || Calculator;\n            return (\n              <div\n                key={service.id}\n                className=\"bg-white rounded border border-[#0D1E38]/15 hover:border-[#9B2C2C] p-5 flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:shadow-lg group relative\"\n              >\n                <div>\n                  {/* Top bar with Index and Badge */}\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <span className=\"font-mono text-xs font-bold text-[#B68A2E] group-hover:text-[#9B2C2C] transition-colors\">\n                      {service.number}\n                    </span>\n                    {service.badge && (\n                      <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-[#9B2C2C]/10 text-[#9B2C2C]\">\n                        {service.badge}\n                      </span>\n                    )}\n                  </div>\n\n                  {/* Service Icon */}\n                  <div className=\"w-10 h-10 rounded bg-[#F6F4EE] border border-[#0D1E38]/10 flex items-center justify-center text-[#0D1E38] group-hover:bg-[#0D1E38] group-hover:text-white transition-colors mb-3\">\n                    <Icon className=\"w-5 h-5\" />\n                  </div>\n\n                  {/* Title */}\n                  <h3 className=\"font-display font-bold text-base sm:text-lg text-[#0D1E38] leading-snug group-hover:text-[#9B2C2C] transition-colors mb-2\">\n                    {service.title}\n                  </h3>\n\n                  {/* Tagline / short description */}\n                  <p className=\"text-xs text-[#5A6376] line-clamp-3 leading-relaxed mb-4\">\n                    {service.tagline}\n                  </p>\n                </div>\n\n                {/* Bottom Actions */}\n                <div className=\"pt-3 border-t border-gray-100 flex items-center justify-between\">\n                  <button\n                    onClick={() => setSelectedService(service)}\n                    className=\"inline-flex items-center gap-1 text-xs font-mono font-semibold text-[#0D1E38] hover:text-[#9B2C2C] transition-colors\"\n                  >\n                    <span>View Details</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <a\n                    href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=${encodeURIComponent(`Hi Sajid Sir, I need assistance with ${service.title}.`)}`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"text-[11px] font-semibold text-[#195E3E] hover:underline\"\n                    title=\"Quick Inquiry on WhatsApp\"\n                  >\n                    Inquire &rarr;\n                  </a>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {filteredServices.length === 0 && (\n          <div className=\"text-center py-12 bg-white rounded border border-dashed border-gray-300 my-8\">\n            <p className=\"text-gray-500 font-mono text-sm\">No services match \"{searchQuery}\".</p>\n            <button\n              onClick={() => { setSearchQuery(\'\'); setActiveCategory(\'all\'); }}\n              className=