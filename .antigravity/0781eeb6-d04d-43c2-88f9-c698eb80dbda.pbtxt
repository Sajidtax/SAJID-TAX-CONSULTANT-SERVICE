      target_content: "export default function Footer() {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-[#0D1E38] text-[#C9D4E5] pt-16 pb-12 border-t-2 border-[#B68A2E]/30 relative z-10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Top Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10\">\n          \n          {/* Col 1: Brand & Bio (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-full border-2 border-[#B68A2E] bg-[#ECE8DD] text-[#0D1E38] font-display font-bold text-lg flex items-center justify-center\">\n                SJ\n              </div>\n              <div>\n                <div className=\"font-display font-bold text-xl text-white\">\n                  {BUSINESS_INFO.name}\n                </div>\n                <div className=\"font-mono text-xs text-[#B68A2E] tracking-wider uppercase\">\n                  @{BUSINESS_INFO.handle}\n                </div>\n              </div>\n            </div>\n\n            <p className=\"text-xs sm:text-sm text-gray-300 leading-relaxed\">\n              Trusted Accounting, Tax preparation, GST filing, ROC company incorporation, Gumasta, and PF claims consultancy practice operating from Opera House, Mumbai.\n            </p>\n\n            <div className=\"pt-2 text-xs font-mono text-[#B68A2E]\">\n              {BUSINESS_INFO.tagline}\n            </div>\n          </div>\n\n          {/* Col 2: Services Quick Links (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-3\">\n            <h4 className=\"font-mono text-xs uppercase font-bold text-white tracking-wider border-b border-white/10 pb-2\">\n              Our 10 Core Services\n            </h4>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-2 gap-y-1.5 text-xs text-gray-300\">\n              {SERVICES_LIST.map((s) => (\n                <a\n                  key={s.id}\n                  href=\"#services\"\n                  className=\"hover:text-amber-300 transition-colors py-0.5\"\n                >\n                  \342\200\242 {s.title}\n                </a>\n              ))}\n            </div>\n          </div>\n\n          {/* Col 3: Direct Contact & Office Hours (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-3\">\n            <h4 className=\"font-mono text-xs uppercase font-bold text-white tracking-wider border-b border-white/10 pb-2\">\n              Office &amp; Contact\n            </h4>\n            \n            <div className=\"space-y-2.5 text-xs text-gray-300\">\n              <div className=\"flex items-start gap-2\">\n                <MapPin className=\"w-4 h-4 text-[#B68A2E] shrink-0 mt-0.5\" />\n                <span>{BUSINESS_INFO.address.full}</span>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <Phone className=\"w-4 h-4 text-[#B68A2E] shrink-0\" />\n                <a href={`tel:${BUSINESS_INFO.phoneClean}`} className=\"font-mono font-bold text-white hover:text-amber-300\">\n                  {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <Mail className=\"w-4 h-4 text-[#B68A2E] shrink-0\" />\n                <a href={`mailto:${BUSINESS_INFO.email}`} className=\"font-mono text-white hover:text-amber-300 break-all\">\n                  {BUSINESS_INFO.email}\n                </a>\n              </div>\n\n              <div className=\"flex items-start gap-2\">\n                <Clock className=\"w-4 h-4 text-[#B68A2E] shrink-0 mt-0.5\" />\n                <div>\n                  <div className=\"font-semibold text-white\">Mon\342\200\223Sat: 11:00 AM \342\200\223 7:00 PM</div>\n                  <div className=\"text-gray-400\">Sunday: Closed</div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2 pt-1 font-mono text-[11px] text-amber-300\">\n                <QrCode className=\"w-3.5 h-3.5\" />\n                <span>UPI ID: {BUSINESS_INFO.upiId}</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom copyright & back to top */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400 font-mono\">\n          <div>\n            &copy; {new Date().getFullYear()} {BUSINESS_INFO.name}. All Rights Reserved.\n          </div>\n\n          <div className=\"flex items-center gap-6\">\n            <span className=\"hidden md:inline text-gray-500\">\n              Opera House, Mumbai - 400004\n            </span>\n            <button\n              onClick={scrollToTop}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 text-white transition-colors\"\n            >\n              <span>Back to Top</span>\n              <ArrowUp className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n}"
      replacement_content: "export default function Footer() {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"bg-[#0A0A0A] text-[#A3A3A3] pt-16 pb-12 border-t border-[#D4AF37]/30 relative z-10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Top Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-[#ffffff12]\">\n          \n          {/* Col 1: Brand & Bio (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-full border-2 border-[#D4AF37] bg-[#141414] text-[#D4AF37] font-display font-bold text-lg flex items-center justify-center\">\n                SJ\n              </div>\n              <div>\n                <div className=\"font-display font-bold text-xl text-[#F5F2ED]\">\n                  {BUSINESS_INFO.name}\n                </div>\n                <div className=\"font-mono text-xs text-[#D4AF37] tracking-wider uppercase\">\n                  @{BUSINESS_INFO.handle}\n                </div>\n              </div>\n            </div>\n\n            <p className=\"text-xs sm:text-sm text-[#A3A3A3] leading-relaxed\">\n              Trusted Accounting, Tax preparation, GST filing, ROC company incorporation, Gumasta, and PF claims consultancy practice operating from Opera House, Mumbai.\n            </p>\n\n            <div className=\"pt-2 text-xs font-mono text-[#D4AF37]\">\n              {BUSINESS_INFO.tagline}\n            </div>\n          </div>\n\n          {/* Col 2: Services Quick Links (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-3\">\n            <h4 className=\"font-mono text-xs uppercase font-bold text-[#F5F2ED] tracking-wider border-b border-[#ffffff12] pb-2\">\n              Our 10 Core Services\n            </h4>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-2 gap-y-1.5 text-xs text-[#D4D4D4]\">\n              {SERVICES_LIST.map((s) => (\n                <a\n                  key={s.id}\n                  href=\"#services\"\n                  className=\"hover:text-[#D4AF37] transition-colors py-0.5\"\n                >\n                  \342\200\242 {s.title}\n                </a>\n              ))}\n            </div>\n          </div>\n\n          {/* Col 3: Direct Contact & Office Hours (4 cols) */}\n          <div className=\"lg:col-span-4 space-y-3\">\n            <h4 className=\"font-mono text-xs uppercase font-bold text-[#F5F2ED] tracking-wider border-b border-[#ffffff12] pb-2\">\n              Office &amp; Contact\n            </h4>\n            \n            <div className=\"space-y-2.5 text-xs text-[#D4D4D4]\">\n              <div className=\"flex items-start gap-2\">\n                <MapPin className=\"w-4 h-4 text-[#D4AF37] shrink-0 mt-0.5\" />\n                <span>{BUSINESS_INFO.address.full}</span>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <Phone className=\"w-4 h-4 text-[#D4AF37] shrink-0\" />\n                <a href={`tel:${BUSINESS_INFO.phoneClean}`} className=\"font-mono font-bold text-[#F5F2ED] hover:text-[#D4AF37]\">\n                  {BUSINESS_INFO.phone}\n                </a>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <Mail className=\"w-4 h-4 text-[#D4AF37] shrink-0\" />\n                <a href={`mailto:${BUSINESS_INFO.email}`} className=\"font-mono text-[#F5F2ED] hover:text-[#D4AF37] break-all\">\n                  {BUSINESS_INFO.email}\n                </a>\n              </div>\n\n              <div className=\"flex items-start gap-2\">\n                <Clock className=\"w-4 h-4 text-[#D4AF37] shrink-0 mt-0.5\" />\n                <div>\n                  <div className=\"font-semibold text-[#F5F2ED]\">Mon\342\200\223Sat: 11:00 AM \342\200\223 7:00 PM</div>\n                  <div className=\"text-[#737373]\">Sunday: Closed</div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-2 pt-1 font-mono text-[11px] text-[#D4AF37]\">\n                <QrCode className=\"w-3.5 h-3.5\" />\n                <span>UPI ID: {BUSINESS_INFO.upiId}</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom copyright & back to top */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#737373] font-mono\">\n          <div>\n            &copy; {new Date().getFullYear()} {BUSINESS_INFO.name}. All Rights Reserved.\n          </div>\n\n          <div className=\"flex items-center gap-6\">\n            <span className=\"hidden md:inline text-[#737373]\">\n              Opera House, Mumbai - 400004\n            </span>\n            <button\n              onClick={scrollToTop}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#171717] hover:bg-[#262626] border border-[#ffffff15] text-[#F5F2ED] transition-colors\"\n            >\n              <span>Back to Top</span>\n              <ArrowUp className=\"w-3.5 h-3.5 text-[#D4AF37]\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n}"
