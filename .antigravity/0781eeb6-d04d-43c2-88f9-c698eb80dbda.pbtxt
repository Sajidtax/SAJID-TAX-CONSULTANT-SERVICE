  file_change {
    absolute_path_uri: "file:///src/components/ServiceDetailModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { X, CheckCircle, FileText, Clock, Phone, MessageSquare } from \'lucide-react\';\nimport { ServiceItem } from \'../types\';\nimport { BUSINESS_INFO } from \'../data/businessData\';\n\ninterface ServiceDetailModalProps {\n  service: ServiceItem | null;\n  onClose: () => void;\n}\n\nexport default function ServiceDetailModal({ service, onClose }: ServiceDetailModalProps) {\n  if (!service) return null;\n\n  const whatsappMessage = encodeURIComponent(\n    `Hello Sajid Sir, I am interested in your service: \"${service.title}\". Please let me know the requirements and fee details.`\n  );\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div \n        className=\"bg-white rounded-lg border border-[#0D1E38]/20 shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative animate-in zoom-in-95 duration-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"bg-[#0D1E38] text-white p-6 sticky top-0 z-10 flex items-start justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-mono text-xs text-[#B68A2E] font-bold tracking-widest uppercase\">\n                Service #{service.number}\n              </span>\n              {service.badge && (\n                <span className=\"bg-[#9B2C2C] text-white text-[10px] uppercase font-mono px-2 py-0.5 rounded font-semibold\">\n                  {service.badge}\n                </span>\n              )}\n            </div>\n            <h3 className=\"text-2xl font-display font-bold mt-1 text-white\">\n              {service.title}\n            </h3>\n            <p className=\"text-gray-300 text-xs sm:text-sm mt-1\">\n              {service.tagline}\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-full bg-white/10 hover:bg-white/25 text-white transition-colors\"\n            aria-label=\"Close modal\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 space-y-6\">\n          {/* Overview */}\n          <div>\n            <h4 className=\"text-xs font-mono font-bold uppercase text-[#9B2C2C] tracking-wider mb-2\">\n              Service Scope &amp; Description\n            </h4>\n            <p className=\"text-sm sm:text-[15px] text-[#3A4354] leading-relaxed\">\n              {service.description}\n            </p>\n          </div>\n\n          {/* Deliverables */}\n          <div className=\"bg-[#F6F4EE] p-4 rounded border border-[#0D1E38]/10\">\n            <h4 className=\"text-xs font-mono font-bold uppercase text-[#0D1E38] tracking-wider mb-3 flex items-center gap-1.5\">\n              <CheckCircle className=\"w-4 h-4 text-[#195E3E]\" />\n              <span>What We Deliver for You</span>\n            </h4>\n            <ul className=\"space-y-2 text-xs sm:text-sm text-[#192231]\">\n              {service.deliverables.map((item, idx) => (\n                <li key={idx} className=\"flex items-start gap-2\">\n                  <span className=\"text-[#195E3E] font-bold mt-0.5\">\342\200\242</span>\n                  <span>{item}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          {/* Required Documents checklist */}\n          <div>\n            <h4 className=\"text-xs font-mono font-bold uppercase text-[#9B2C2C] tracking-wider mb-3 flex items-center gap-1.5\">\n              <FileText className=\"w-4 h-4\" />\n              <span>Documents Required From You</span>\n            </h4>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm\">\n              {service.documentsRequired.map((doc, idx) => (\n                <div key={idx} className=\"flex items-center gap-2 p-2.5 rounded bg-gray-50 border border-gray-200\">\n                  <span className=\"w-4 h-4 rounded-full bg-amber-100 text-[#B68A2E] text-[10px] font-bold flex items-center justify-center shrink-0\">\n                    {idx + 1}\n                  </span>\n                  <span className=\"text-[#3A4354] font-medium\">{doc}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Turnaround Time */}\n          <div className=\"flex items-center gap-2 text-xs font-mono text-gray-700 bg-amber-50 border border-amber-200/80 p-3 rounded\">\n            <Clock className=\"w-4 h-4 text-[#B68A2E] shrink-0\" />\n            <span><strong>Turnaround Time:</strong> {service.turnaroundTime}</span>\n          </div>\n\n          {/* Fast Actions */}\n          <div className=\"pt-2 flex flex-col sm:flex-row items-center gap-3 border-t border-gray-100\">\n            <a\n              href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=${whatsappMessage}`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full sm:flex-1 py-3 px-4 rounded bg-[#195E3E] hover:bg-[#144b31] text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-sm\"\n            >\n              <MessageSquare className=\"w-4 h-4\" />\n              <span>Inquire via WhatsApp</span>\n            </a>\n            <a\n              href={`tel:${BUSINESS_INFO.phoneClean}`}\n              className=\"w-full sm:flex-1 py-3 px-4 rounded bg-[#9B2C2C] hover:bg-[#822424] text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all shadow-[2px_2px_0px_#0D1E38]\"\n            >\n              <Phone className=\"w-4 h-4\" />\n              <span>Call: {BUSINESS_INFO.phone}</span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
