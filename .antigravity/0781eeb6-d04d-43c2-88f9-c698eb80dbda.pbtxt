  file_change {
    absolute_path_uri: "file:///src/components/WhyChooseUs.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ShieldCheck, Clock, UserCheck, Banknote } from \'lucide-react\';\nimport { BUSINESS_INFO } from \'../data/businessData\';\n\nexport default function WhyChooseUs() {\n  const reasons = [\n    {\n      letter: \"A\",\n      title: \"One Firm, Every Filing\",\n      desc: \"Accounting, Auditing, GST, TDS, PF, Gumasta, and MCA registrations all handled under one roof. No juggling between separate agents or fragmented consultants.\",\n      icon: ShieldCheck\n    },\n    {\n      letter: \"B\",\n      title: \"Deadlines Tracked For You\",\n      desc: \"We actively monitor statutory cutoff dates and send timely reminders, protecting your business from late fees, interest, and blocked Input Tax Credit (ITC).\",\n      icon: Clock\n    },\n    {\n      letter: \"C\",\n      title: \"Direct Access to Consultant Sajid\",\n      desc: \"Speak directly with the professional analyzing your accounts and filing your returns \342\200\224 not an outsourced call center or junior ticket desk.\",\n      icon: UserCheck\n    },\n    {\n      letter: \"D\",\n      title: \"Clear, Upfront Pricing & Ethics\",\n      desc: \"Transparent quotes with no hidden charges. Full confidentiality of client financial records with complete integrity.\",\n      icon: Banknote\n    }\n  ];\n\n  return (\n    <section id=\"why-us\" className=\"py-20 bg-[#ECE8DD] border-t border-[#0D1E38]/10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start\">\n          \n          {/* Left Column: Heading & Value Prop */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#9B2C2C] tracking-widest\">\n              <span className=\"w-6 h-[1.5px] bg-[#9B2C2C]\"></span>\n              <span>Why Choose Sajid Tax Consultant</span>\n            </div>\n            \n            <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#0D1E38] leading-tight\">\n              Built for business owners who value accuracy, time, and peace of mind.\n            </h2>\n            \n            <p className=\"text-sm sm:text-base text-[#3A4354] leading-relaxed\">\n              Operating centrally from Opera House, Mumbai, we combine rigorous compliance expertise with personal accountability to empower local enterprises and individual taxpayers.\n            </p>\n\n            <div className=\"p-5 rounded bg-white border border-[#0D1E38]/10 shadow-sm space-y-3\">\n              <div className=\"text-xs font-mono font-bold uppercase text-[#195E3E]\">\n                Client Commitment\n              </div>\n              <p className=\"text-xs sm:text-sm text-[#192231] italic\">\n                &ldquo;Every return we file is treated with the highest standard of accuracy as if it were our own. Your growth is our responsibility.&rdquo;\n              </p>\n              <div className=\"text-xs font-bold text-[#0D1E38]\">\n                \342\200\224 Sajid (Tax &amp; Accounting Consultant)\n              </div>\n            </div>\n\n            <div className=\"pt-2\">\n              <a\n                href={`tel:${BUSINESS_INFO.phoneClean}`}\n                className=\"inline-flex items-center justify-center gap-2 px-6 py-3 rounded bg-[#0D1E38] text-white font-semibold text-xs sm:text-sm hover:bg-[#152e54] transition-all shadow-[2px_2px_0px_#B68A2E]\"\n              >\n                <span>Consult with Sajid: {BUSINESS_INFO.phone}</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Right Column: 4 Distinct Pillars */}\n          <div className=\"lg:col-span-7 space-y-4\">\n            {reasons.map((item) => {\n              const Icon = item.icon;\n              return (\n                <div\n                  key={item.letter}\n                  className=\"bg-white rounded p-5 sm:p-6 border border-[#0D1E38]/15 hover:border-[#9B2C2C] transition-all shadow-sm flex items-start gap-4 group\"\n                >\n                  <div className=\"w-10 h-10 rounded bg-[#F6F4EE] border border-[#0D1E38]/10 flex items-center justify-center font-mono font-bold text-[#9B2C2C] shrink-0 group-hover:bg-[#9B2C2C] group-hover:text-white transition-colors\">\n                    {item.letter}\n                  </div>\n                  <div className=\"space-y-1 flex-1\">\n                    <div className=\"flex items-center justify-between\">\n                      <h3 className=\"font-display font-bold text-base sm:text-lg text-[#0D1E38]\">\n                        {item.title}\n                      </h3>\n                      <Icon className=\"w-4 h-4 text-gray-400 group-hover:text-[#9B2C2C] transition-colors\" />\n                    </div>\n                    <p className=\"text-xs sm:text-sm text-[#5A6376] leading-relaxed\">\n                      {item.desc}\n                    </p>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
