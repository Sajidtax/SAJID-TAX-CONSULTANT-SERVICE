  file_change {
    absolute_path_uri: "file:///src/components/ComplianceCalendarSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { Calendar, AlertCircle, Clock, ShieldAlert, ArrowUpRight } from \'lucide-react\';\nimport { COMPLIANCE_CALENDAR, BUSINESS_INFO } from \'../data/businessData\';\n\nexport default function ComplianceCalendarSection() {\n  const [selectedCategory, setSelectedCategory] = useState<\'ALL\' | \'GST\' | \'ITR\' | \'TDS\' | \'PF\'>(\'ALL\');\n\n  const filteredDeadlines = selectedCategory === \'ALL\'\n    ? COMPLIANCE_CALENDAR\n    : COMPLIANCE_CALENDAR.filter(item => item.category === selectedCategory);\n\n  return (\n    <section id=\"due-dates\" className=\"py-20 bg-[#F6F4EE] relative\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-10 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#9B2C2C] tracking-widest\">\n            <span className=\"w-6 h-[1.5px] bg-[#9B2C2C]\"></span>\n            <span>Statutory Compliance Calendar</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#0D1E38] tracking-tight\">\n            Upcoming Deadlines &amp; Filing Timelines\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#3A4354] leading-relaxed\">\n            Avoid heavy government penalties, late filing fees, and blocked Input Tax Credit (ITC). We track every deadline on your behalf.\n          </p>\n        </div>\n\n        {/* Filter Pills */}\n        <div className=\"flex flex-wrap gap-2 mb-8\">\n          {([\'ALL\', \'GST\', \'ITR\', \'TDS\', \'PF\'] as const).map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setSelectedCategory(cat)}\n              className={`px-3.5 py-1.5 rounded text-xs font-mono font-semibold transition-all ${\n                selectedCategory === cat\n                  ? \'bg-[#0D1E38] text-white shadow-sm\'\n                  : \'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50\'\n              }`}\n            >\n              {cat === \'ALL\' ? \'All Deadlines\' : `${cat} Filings`}\n            </button>\n          ))}\n        </div>\n\n        {/* Deadlines Table/Grid */}\n        <div className=\"bg-white rounded-lg border border-[#0D1E38]/15 shadow-sm overflow-hidden\">\n          <div className=\"divide-y divide-gray-200\">\n            {filteredDeadlines.map((item) => (\n              <div\n                key={item.id}\n                className=\"p-5 sm:p-6 hover:bg-[#F6F4EE]/40 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-4\"\n              >\n                <div className=\"space-y-1 max-w-xl\">\n                  <div className=\"flex items-center gap-2 flex-wrap\">\n                    <span className=\"font-mono text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-gray-100 text-gray-700\">\n                      {item.category}\n                    </span>\n                    <span className=\"text-xs font-mono text-gray-500\">\n                      {item.frequency}\n                    </span>\n                    {item.importance === \'urgent\' && (\n                      <span className=\"flex items-center gap-1 font-mono text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-red-100 text-[#9B2C2C]\">\n                        <AlertCircle className=\"w-3 h-3\" />\n                        Critical\n                      </span>\n                    )}\n                  </div>\n                  <h3 className=\"font-display font-bold text-base sm:text-lg text-[#0D1E38]\">\n                    {item.title}\n                  </h3>\n                  <p className=\"text-xs sm:text-sm text-[#4A5364] leading-relaxed\">\n                    {item.description}\n                  </p>\n                </div>\n\n                <div className=\"flex items-center sm:items-end md:flex-col justify-between shrink-0 gap-3 border-t md:border-t-0 pt-3 md:pt-0 border-dashed border-gray-200\">\n                  <div className=\"text-left md:text-right\">\n                    <div className=\"text-[10px] font-mono uppercase text-gray-500 font-semibold\">\n                      Statutory Due Date\n                    </div>\n                    <div className=\"text-sm sm:text-base font-mono font-bold text-[#9B2C2C]\">\n                      {item.dueDate}\n                    </div>\n                  </div>\n\n                  <a\n                    href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=${encodeURIComponent(`Hello Sajid Sir, I need help filing ${item.title} before the due date.`)}`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded bg-[#0D1E38] hover:bg-[#152e54] text-white transition-colors\"\n                  >\n                    <span>File with Sajid</span>\n                    <ArrowUpRight className=\"w-3.5 h-3.5\" />\n                  </a>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Penalty Warning Callout */}\n        <div className=\"mt-6 p-4 rounded bg-amber-50/80 border border-amber-200/80 flex items-start gap-3 text-xs text-amber-900\">\n          <ShieldAlert className=\"w-5 h-5 text-amber-700 shrink-0 mt-0.5\" />\n          <div>\n            <strong>Notice on Late Fees &amp; Interest:</strong> Non-filing or late filing of GST attracts daily fees up to \342\202\27150/day plus 18% annual interest. Delayed TDS payments incur 1.5% interest per month. Contact our Opera House office at <a href={`tel:${BUSINESS_INFO.phoneClean}`} className=\"underline font-bold text-[#0D1E38]\">{BUSINESS_INFO.phone}</a> to avoid penal actions.\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
