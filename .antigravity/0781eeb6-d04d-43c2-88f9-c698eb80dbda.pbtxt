  file_change {
    absolute_path_uri: "file:///src/components/OfficeLocation.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <section id=\"office\" className=\"py-20 bg-[#F6F4EE] border-t border-[#0D1E38]/10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#9B2C2C] tracking-widest\">\n            <span className=\"w-6 h-[1.5px] bg-[#9B2C2C]\"></span>\n            <span>Physical Office &amp; Working Hours</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#0D1E38] tracking-tight\">\n            Visit Our Opera House Office\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#3A4354] leading-relaxed\">\n            Centrally situated near Prasad Chamber at Opera House in South Mumbai. You are welcome to visit for in-person consultations during office hours or connect digitally.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Office Address Details Card */}\n          <div className=\"lg:col-span-7 bg-white rounded-lg border border-[#0D1E38]/15 shadow-sm p-6 sm:p-8 space-y-6\">\n            \n            <div className=\"flex items-start justify-between gap-4\">\n              <div className=\"flex items-start gap-3\">\n                <div className=\"w-10 h-10 rounded bg-[#9B2C2C]/10 text-[#9B2C2C] flex items-center justify-center shrink-0 mt-1\">\n                  <MapPin className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"font-mono text-xs font-bold text-[#9B2C2C] uppercase tracking-wider\">\n                    Registered Office Address\n                  </div>\n                  <h3 className=\"font-display font-bold text-xl sm:text-2xl text-[#0D1E38] mt-1\">\n                    {BUSINESS_INFO.name}\n                  </h3>\n                </div>\n              </div>\n\n              <button\n                onClick={handleCopyAddress}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-gray-200 text-xs font-mono font-medium hover:bg-gray-50 text-gray-700 transition-all shrink-0\"\n                title=\"Copy full address\"\n              >\n                {copiedAddress ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span className=\"text-emerald-600\">Copied!</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3.5 h-3.5 text-gray-500\" />\n                    <span>Copy Address</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* Address Breakdown */}\n            <div className=\"bg-[#F6F4EE] p-4 sm:p-5 rounded border border-[#0D1E38]/10 space-y-1.5 text-sm sm:text-base text-[#192231]\">\n              <p className=\"font-semibold text-[#0D1E38]\">{BUSINESS_INFO.address.line1}</p>\n              <p>{BUSINESS_INFO.address.line2}</p>\n              <p className=\"font-medium text-[#9B2C2C]\">{BUSINESS_INFO.address.area} - {BUSINESS_INFO.address.pincode}</p>\n              <p className=\"text-xs font-mono text-gray-500\">{BUSINESS_INFO.address.state}</p>\n            </div>\n\n            {/* Quick action buttons for location */}\n            <div className=\"flex flex-wrap gap-3 pt-2\">\n              <a\n                href={BUSINESS_INFO.googleMapsUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#0D1E38] hover:bg-[#152e54] text-white font-semibold text-xs sm:text-sm transition-all shadow-[2px_2px_0px_#B68A2E]\"\n              >\n                <Navigation className=\"w-4 h-4\" />\n                <span>Get Directions (Google Maps)</span>\n              </a>\n\n              <a\n                href={`tel:${BUSINESS_INFO.phoneClean}`}\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 rounded border border-[#0D1E38]/20 bg-white hover:bg-gray-50 text-[#0D1E38] font-semibold text-xs sm:text-sm transition-all\"\n              >\n                <Phone className=\"w-4 h-4 text-[#9B2C2C]\" />\n                <span>Call: {BUSINESS_INFO.phone}</span>\n              </a>\n            </div>\n\n            {/* Digital UPI Payment Details from Screenshot */}\n            <div className=\"pt-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50/80 p-4 rounded border border-gray-200\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded bg-white border border-gray-200 flex items-center justify-center text-[#0D1E38] shrink-0\">\n                  <QrCode className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"text-[10px] font-mono uppercase text-gray-500 font-bold\">\n                    Official Consultation UPI ID\n                  </div>\n                  <div className=\"font-mono text-xs sm:text-sm font-bold text-[#0D1E38]\">\n                    {BUSINESS_INFO.upiId}\n                  </div>\n                </div>\n              </div>\n\n              <button\n                onClick={handleCopyUpi}\n                className=\"inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded bg-white border border-gray-300 text-xs font-mono font-semibold hover:bg-gray-100 text-gray-700 transition-all self-start sm:self-auto\"\n              >\n                {copiedUpi ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span className=\"text-emerald-600\">UPI Copied</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3.5 h-3.5 text-gray-500\" />\n                    <span>Copy UPI</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n          </div>\n\n          {/* Right Column: Working Hours Matrix Card */}\n          <div className=\"lg:col-span-5 bg-white rounded-lg border border-[#0D1E38]/15 shadow-sm p-6 sm:p-8 space-y-6\">\n            \n            <div className=\"flex items-center justify-between border-b border-[#0D1E38]/10 pb-4\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-8 h-8 rounded bg-emerald-50 text-[#195E3E] flex items-center justify-center\">\n                  <Clock className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h3 className=\"font-display font-bold text-lg text-[#0D1E38]\">\n                    Working Hours\n                  </h3>\n                  <p className=\"text-xs text-gray-500\">Official Operational Timings</p>\n                </div>\n              </div>\n\n              <div className={`px-2.5 py-1 rounded text-xs font-mono font-bold uppercase ${\n                status.isOpen ? \'bg-emerald-100 text-[#195E3E]\' : \'bg-amber-100 text-amber-800\'\n              }`}>\n                {status.text}\n              </div>\n            </div>\n\n            {/* Days Schedule List */}\n            <div className=\"space-y-2 text-xs sm:text-sm font-mono\">\n              {WORKING_HOURS.map((item) => (\n                <div\n                  key={item.day}\n                  className={`flex items-center justify-between py-2 px-3 rounded transition-colors ${\n                    item.isOpen \n                      ? \'bg-gray-50/80 border border-gray-100 text-[#192231]\' \n                      : \'bg-red-50/50 border border-red-100 text-[#9B2C2C] font-semibold\'\n                  }`}\n                >\n                  <span className=\"font-medium\">{item.day}</span>\n                  <span className={item.isOpen ? \'text-[#0D1E38] font-bold\' : \'text-[#9B2C2C] uppercase\'}>\n                    {item.hours}\n                  </span>\n                </div>\n              ))}\n            </div>\n\n            {/* Contact Note */}\n            <div className=\"pt-2 border-t border-gray-100 text-xs text-gray-600 space-y-1\">\n              <p className=\"flex items-center gap-1.5\">\n                <Mail className=\"w-3.5 h-3.5 text-[#9B2C2C]\" />\n                <span>Email: <a href={`mailto:${BUSINESS_INFO.email}`} className=\"font-mono font-semibold text-[#0D1E38] hover:underline\">{BUSINESS_INFO.email}</a></span>\n              </p>\n              <p className=\"text-[11px] text-gray-500\">\n                * Sunday appointments can be arranged upon prior phone confirmation for urgent tax filing deadlines.\n              </p>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );"
      replacement_content: "  return (\n    <section id=\"office\" className=\"py-20 bg-[#0D0D0D] border-t border-[#ffffff12]\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#D4AF37] tracking-widest\">\n            <span className=\"w-6 h-[1.5px] bg-[#D4AF37]\"></span>\n            <span>Physical Office &amp; Working Hours</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#F5F2ED] tracking-tight\">\n            Visit Our Opera House Office\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#A3A3A3] leading-relaxed\">\n            Centrally situated near Prasad Chamber at Opera House in South Mumbai. You are welcome to visit for in-person consultations during office hours or connect digitally.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Office Address Details Card */}\n          <div className=\"lg:col-span-7 bg-[#141414] rounded-lg border border-[#ffffff15] shadow-xl p-6 sm:p-8 space-y-6\">\n            \n            <div className=\"flex items-start justify-between gap-4\">\n              <div className=\"flex items-start gap-3\">\n                <div className=\"w-10 h-10 rounded bg-[#1C1C1C] border border-[#D4AF37]/30 text-[#D4AF37] flex items-center justify-center shrink-0 mt-1\">\n                  <MapPin className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <div className=\"font-mono text-xs font-bold text-[#D4AF37] uppercase tracking-wider\">\n                    Registered Office Address\n                  </div>\n                  <h3 className=\"font-display font-bold text-xl sm:text-2xl text-[#F5F2ED] mt-1\">\n                    {BUSINESS_INFO.name}\n                  </h3>\n                </div>\n              </div>\n\n              <button\n                onClick={handleCopyAddress}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-[#ffffff18] text-xs font-mono font-medium hover:bg-[#262626] text-[#D4D4D4] transition-all shrink-0\"\n                title=\"Copy full address\"\n              >\n                {copiedAddress ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span className=\"text-emerald-400\">Copied!</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3.5 h-3.5 text-[#A3A3A3]\" />\n                    <span>Copy Address</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n            {/* Address Breakdown */}\n            <div className=\"bg-[#1A1A1A] p-4 sm:p-5 rounded border border-[#ffffff12] space-y-1.5 text-sm sm:text-base text-[#D4D4D4]\">\n              <p className=\"font-semibold text-[#F5F2ED]\">{BUSINESS_INFO.address.line1}</p>\n              <p>{BUSINESS_INFO.address.line2}</p>\n              <p className=\"font-medium text-[#D4AF37]\">{BUSINESS_INFO.address.area} - {BUSINESS_INFO.address.pincode}</p>\n              <p className=\"text-xs font-mono text-[#A3A3A3]\">{BUSINESS_INFO.address.state}</p>\n            </div>\n\n            {/* Quick action buttons for location */}\n            <div className=\"flex flex-wrap gap-3 pt-2\">\n              <a\n                href={BUSINESS_INFO.googleMapsUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[#D4AF37] hover:bg-[#E5C158] text-[#0A0A0A] font-bold text-xs sm:text-sm transition-all shadow-[2px_2px_0px_rgba(255,255,255,0.15)]\"\n              >\n                <Navigation className=\"w-4 h-4\" />\n                <span>Get Directions (Google Maps)</span>\n              </a>\n\n              <a\n                href={`tel:${BUSINESS_INFO.phoneClean}`}\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 rounded border border-[#ffffff18] bg-[#1A1A1A] hover:bg-[#262626] text-[#F5F2ED] font-semibold text-xs sm:text-sm transition-all\"\n              >\n                <Phone className=\"w-4 h-4 text-[#D4AF37]\" />\n                <span>Call: {BUSINESS_INFO.phone}</span>\n              </a>\n            </div>\n\n            {/* Digital UPI Payment Details from Screenshot */}\n            <div className=\"pt-4 border-t border-[#ffffff10] flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#1A1A1A] p-4 rounded border border-[#ffffff12]\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded bg-[#262626] border border-[#ffffff18] flex items-center justify-center text-[#D4AF37] shrink-0\">\n                  <QrCode className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"text-[10px] font-mono uppercase text-[#A3A3A3] font-bold\">\n                    Official Consultation UPI ID\n                  </div>\n                  <div className=\"font-mono text-xs sm:text-sm font-bold text-[#F5F2ED]\">\n                    {BUSINESS_INFO.upiId}\n                  </div>\n                </div>\n              </div>\n\n              <button\n                onClick={handleCopyUpi}\n                className=\"inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded bg-[#262626] border border-[#ffffff20] text-xs font-mono font-semibold hover:bg-[#333333] text-[#F5F2ED] transition-all self-start sm:self-auto\"\n              >\n                {copiedUpi ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span className=\"text-emerald-400\">UPI Copied</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy className=\"w-3.5 h-3.5 text-[#A3A3A3]\" />\n                    <span>Copy UPI</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n          </div>\n\n          {/* Right Column: Working Hours Matrix Card */}\n          <div className=\"lg:col-span-5 bg-[#141414] rounded-lg border border-[#ffffff15] shadow-xl p-6 sm:p-8 space-y-6\">\n            \n            <div className=\"flex items-center justify-between border-b border-[#ffffff12] pb-4\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-8 h-8 rounded bg-[#1C1C1C] text-[#D4AF37] border border-[#D4AF37]/30 flex items-center justify-center\">\n                  <Clock className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h3 className=\"font-display font-bold text-lg text-[#F5F2ED]\">\n                    Working Hours\n                  </h3>\n                  <p className=\"text-xs text-[#A3A3A3]\">Official Operational Timings</p>\n                </div>\n              </div>\n\n              <div className={`px-2.5 py-1 rounded text-xs font-mono font-bold uppercase border ${\n                status.isOpen ? \'bg-emerald-950/80 text-emerald-400 border-emerald-500/30\' : \'bg-amber-950/80 text-amber-400 border-amber-500/30\'\n              }`}>\n                {status.text}\n              </div>\n            </div>\n\n            {/* Days Schedule List */}\n            <div className=\"space-y-2 text-xs sm:text-sm font-mono\">\n              {WORKING_HOURS.map((item) => (\n                <div\n                  key={item.day}\n                  className={`flex items-center justify-between py-2 px-3 rounded transition-colors ${\n                    item.isOpen \n                      ? \'bg-[#1A1A1A] border border-[#ffffff10] text-[#D4D4D4]\' \n                      : \'bg-[#1A1A1A] border border-[#ffffff10] text-red-400 font-semibold\'\n                  }`}\n                >\n                  <span className=\"font-medium\">{item.day}</span>\n                  <span className={item.isOpen ? \'text-[#F5F2ED] font-bold\' : \'text-red-400 uppercase\'}>\n                    {item.hours}\n                  </span>\n                </div>\n              ))}\n            </div>\n\n            {/* Contact Note */}\n            <div className=\"pt-2 border-t border-[#ffffff12] text-xs text-[#A3A3A3] space-y-1\">\n              <p className=\"flex items-center gap-1.5\">\n                <Mail className=\"w-3.5 h-3.5 text-[#D4AF37]\" />\n                <span>Email: <a href={`mailto:${BUSINESS_INFO.email}`} className=\"font-mono font-semibold text-[#D4AF37] hover:underline\">{BUSINESS_INFO.email}</a></span>\n              </p>\n              <p className=\"text-[11px] text-[#737373]\">\n                * Sunday appointments can be arranged upon prior phone confirmation for urgent tax filing deadlines.\n              </p>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );"
    }
