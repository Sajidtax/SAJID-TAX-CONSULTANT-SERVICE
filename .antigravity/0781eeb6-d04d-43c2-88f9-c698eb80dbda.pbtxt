lex items-center justify-between gap-4\">\n        {/* Brand identity */}\n        <a href=\"#\" className=\"flex items-center gap-3 group text-left\">\n          <div className=\"w-10 h-10 rounded-full border-2 border-[#0D1E38] bg-[#ECE8DD] flex items-center justify-center font-display font-bold text-[#0D1E38] text-lg shadow-sm group-hover:border-[#9B2C2C] group-hover:bg-[#9B2C2C] group-hover:text-white transition-all\">\n            SJ\n          </div>\n          <div>\n            <div className=\"font-display font-bold text-lg sm:text-xl text-[#0D1E38] leading-tight tracking-tight\">\n              {BUSINESS_INFO.name}\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-mono text-[10px] sm:text-[11px] font-semibold text-[#9B2C2C] uppercase tracking-wider\">\n                @{BUSINESS_INFO.handle}\n              </span>\n              <span className=\"text-gray-400 text-xs\">\342\200\242</span>\n              <span className=\"text-[11px] text-gray-600 hidden md:inline\">\n                Opera House, Mumbai\n              </span>\n            </div>\n          </div>\n        </a>\n\n        {/* Desktop Navigation Links */}\n        <nav className=\"hidden lg:flex items-center gap-7 text-[14.5px] font-medium text-[#192231]\">\n          <a href=\"#services\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">Services</a>\n          <a href=\"#due-dates\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">Due Dates</a>\n          <a href=\"#process\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">How It Works</a>\n          <a href=\"#why-us\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">Why Us</a>\n          <a href=\"#office\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">Office & Hours</a>\n          <a href=\"#contact\" className=\"hover:text-[#9B2C2C] transition-colors py-1\">Contact</a>\n        </nav>\n\n        {/* Fast Action Buttons */}\n        <div className=\"hidden sm:flex items-center gap-3\">\n          <a\n            href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20assistance%20with%20accounting%20and%20tax%20services.`}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded bg-[#195E3E] text-white hover:bg-[#144b31] transition-all shadow-sm\"\n          >\n            <MessageSquare className=\"w-3.5 h-3.5\" />\n            <span>WhatsApp</span>\n          </a>\n          <a\n            href={`tel:${BUSINESS_INFO.phoneClean}`}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider rounded bg-[#9B2C2C] text-white hover:bg-[#822424] transition-all shadow-[2px_2px_0px_#0D1E38] hover:translate-x-[-1px] hover:translate-y-[-1px]\"\n          >\n            <Phone className=\"w-3.5 h-3.5\" />\n            <span>Call {BUSINESS_INFO.phone}</span>\n          </a>\n        </div>\n\n        {/* Mobile menu toggle */}\n        <button\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n          className=\"p-2 text-[#0D1E38] lg:hidden hover:bg-gray-200/60 rounded\"\n          aria-label=\"Toggle Navigation\"\n        >\n          {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden border-t border-[#0D1E38]/12 bg-[#F6F4EE] px-5 py-5 space-y-4 shadow-lg animate-in slide-in-from-top duration-200\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-[#0D1E38]/10 text-xs\">\n            <span className=\"font-mono text-gray-600\">Hours: Mon-Sat 11 AM - 7 PM</span>\n            <span className={`font-mono font-bold ${status.isOpen ? \'text-emerald-700\' : \'text-amber-700\'}`}>\n              {status.text}\n            </span>\n          </div>\n\n          <div className=\"flex flex-col space-y-3 text-base font-medium\">\n            <a\n              href=\"#services\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Services (10 Essential Offerings)\n            </a>\n            <a\n              href=\"#due-dates\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Compliance Calendar & Due Dates\n            </a>\n            <a\n              href=\"#process\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Our Process\n            </a>\n            <a\n              href=\"#why-us\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Why Choose Us\n            </a>\n            <a\n              href=\"#office\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Opera House Office & Hours\n            </a>\n            <a\n              href=\"#contact\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#0D1E38] hover:text-[#9B2C2C]\"\n            >\n              Contact & Callback\n            </a>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#0D1E38]/10 flex flex-col gap-2.5\">\n            <a\n              href={`tel:${BUSINESS_INFO.phoneClean}`}\n              className=\"flex items-center justify-center gap-2 py-3 bg-[#9B2C2C] text-white font-bold text-sm rounded shadow-[2px_2px_0px_#0D1E38]\"\n            >\n              <Phone className=\"w-4 h-4\" />\n              <span>Call: {BUSINESS_INFO.phone}</span>\n            </a>\n            <a\n              href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20help%20with%20tax%20and%20accounting.`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center gap-2 py-3 bg-[#195E3E] text-white font-semibold text-sm rounded\"\n            >\n              <MessageSquare className=\"w-4 h-4\" />\n              <span>WhatsApp Direct Message</span>\n            </a>\n          </div>\n        </div>\n      )}\n    </header>"
      replacement_content: "    <header className=\"sticky top-0 z-40 bg-[#0A0A0A]/95 backdrop-blur-md border-b border-[#ffffff15] transition-all\">\n      {/* Top micro-bar for quick contact & office status */}\n      <div className=\"bg-[#111111] text-[#E5E5E5] text-xs py-2 px-4 border-b border-white/5 hidden sm:block\">\n        <div className=\"max-w-6xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-6\">\n            <div className=\"flex items-center gap-2\">\n              <span className={`w-2 h-2 rounded-full ${status.isOpen ? \'bg-emerald-400 animate-pulse\' : \'bg-[#D4AF37]\'}`}></span>\n              <span className=\"font-mono text-[11px] uppercase tracking-wider text-[#D4AF37]\">\n                {status.text}\n              </span>\n              <span className=\"text-[#A3A3A3] text-[11px]\">({status.detail})</span>\n            </div>\n            <div className=\"flex items-center gap-1.5 text-[#A3A3A3] text-[11px]\">\n              <MapPin className=\"w-3 h-3 text-[#D4AF37]\" />\n              <span>Opera House, Mumbai - 400004</span>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-5 font-mono text-[11px]\">\n            <a\n              href={`mailto:${BUSINESS_INFO.email}`}\n              className=\"text-[#D4D4D4] hover:text-[#D4AF37] transition-colors flex items-center gap-1\"\n            >\n              <span>{BUSINESS_INFO.email}</span>\n            </a>\n            <span className=\"text-[#404040]\">|</span>\n            <a\n              href={`tel:${BUSINESS_INFO.phoneClean}`}\n              className=\"font-semibold text-[#D4AF37] hover:text-[#E5C158] transition-colors flex items-center gap-1\"\n            >\n              <Phone className=\"w-3 h-3\" />\n              <span>{BUSINESS_INFO.phone}</span>\n            </a>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Navigation Bar */}\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4\">\n        {/* Brand identity */}\n        <a href=\"#\" className=\"flex items-center gap-3 group text-left\">\n          <div className=\"w-10 h-10 rounded-full border border-[#D4AF37]/60 bg-[#171717] flex items-center justify-center font-display font-bold text-[#D4AF37] text-lg shadow-sm group-hover:border-[#D4AF37] group-hover:bg-[#D4AF37] group-hover:text-[#0A0A0A] transition-all\">\n            SJ\n          </div>\n          <div>\n            <div className=\"font-display font-bold text-lg sm:text-xl text-[#F5F2ED] leading-tight tracking-tight\">\n              {BUSINESS_INFO.name}\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-mono text-[10px] sm:text-[11px] font-semibold text-[#D4AF37] uppercase tracking-wider\">\n                @{BUSINESS_INFO.handle}\n              </span>\n              <span className=\"text-[#525252] text-xs\">\342\200\242</span>\n              <span className=\"text-[11px] text-[#A3A3A3] hidden md:inline\">\n                Opera House, Mumbai\n              </span>\n            </div>\n          </div>\n        </a>\n\n        {/* Desktop Navigation Links */}\n        <nav className=\"hidden lg:flex items-center gap-7 text-[14.5px] font-medium text-[#D4D4D4]\">\n          <a href=\"#services\" className=\"hover:text-[#D4AF37] transition-colors py-1\">Services</a>\n          <a href=\"#due-dates\" className=\"hover:text-[#D4AF37] transition-colors py-1\">Due Dates</a>\n          <a href=\"#process\" className=\"hover:text-[#D4AF37] transition-colors py-1\">How It Works</a>\n          <a href=\"#why-us\" className=\"hover:text-[#D4AF37] transition-colors py-1\">Why Us</a>\n          <a href=\"#office\" className=\"hover:text-[#D4AF37] transition-colors py-1\">Office &amp; Hours</a>\n          <a href=\"#contact\" className=\"hover:text-[#D4AF37] transition-colors py-1\">Contact</a>\n        </nav>\n\n        {/* Fast Action Buttons */}\n        <div className=\"hidden sm:flex items-center gap-3\">\n          <a\n            href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20assistance%20with%20accounting%20and%20tax%20services.`}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded bg-[#195E3E] text-white hover:bg-[#1f754d] transition-all shadow-sm border border-[#195E3E]/40\"\n          >\n            <MessageSquare className=\"w-3.5 h-3.5\" />\n            <span>WhatsApp</span>\n          </a>\n          <a\n            href={`tel:${BUSINESS_INFO.phoneClean}`}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-bold uppercase tracking-wider rounded bg-[#D4AF37] text-[#0A0A0A] hover:bg-[#E5C158] transition-all shadow-[2px_2px_0px_rgba(255,255,255,0.15)] hover:translate-x-[-1px] hover:translate-y-[-1px]\"\n          >\n            <Phone className=\"w-3.5 h-3.5\" />\n            <span>Call {BUSINESS_INFO.phone}</span>\n          </a>\n        </div>\n\n        {/* Mobile menu toggle */}\n        <button\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n          className=\"p-2 text-[#F5F2ED] lg:hidden hover:bg-[#262626] rounded border border-white/10\"\n          aria-label=\"Toggle Navigation\"\n        >\n          {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden border-t border-[#ffffff15] bg-[#121212] px-5 py-5 space-y-4 shadow-2xl animate-in slide-in-from-top duration-200\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-[#ffffff10] text-xs\">\n            <span className=\"font-mono text-[#A3A3A3]\">Hours: Mon-Sat 11 AM - 7 PM</span>\n            <span className={`font-mono font-bold ${status.isOpen ? \'text-emerald-400\' : \'text-[#D4AF37]\'}`}>\n              {status.text}\n            </span>\n          </div>\n\n          <div className=\"flex flex-col space-y-3 text-base font-medium\">\n            <a\n              href=\"#services\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Services (10 Essential Offerings)\n            </a>\n            <a\n              href=\"#due-dates\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Compliance Calendar &amp; Due Dates\n            </a>\n            <a\n              href=\"#process\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Our Process\n            </a>\n            <a\n              href=\"#why-us\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Why Choose Us\n            </a>\n            <a\n              href=\"#office\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Opera House Office &amp; Hours\n            </a>\n            <a\n              href=\"#contact\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 text-[#F5F2ED] hover:text-[#D4AF37]\"\n            >\n              Contact &amp; Callback\n            </a>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#ffffff10] flex flex-col gap-2.5\">\n            <a\n              href={`tel:${BUSINESS_INFO.phoneClean}`}\n              className=\"flex items-center justify-center gap-2 py-3 bg-[#D4AF37] text-[#0A0A0A] font-bold text-sm rounded shadow-[2px_2px_0px_rgba(255,255,255,0.1)]\"\n            >\n              <Phone className=\"w-4 h-4\" />\n              <span>Call: {BUSINESS_INFO.phone}</span>\n            </a>\n            <a\n              href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20help%20with%20tax%20and%20accounting.`}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"flex items-center justify-center gap-2 py-3 bg-[#195E3E] text-white font-semibold text-sm rounded border border-[#195E3E]/40\"\n            >\n              <MessageSquare className=\"w-4 h-4\" />\n              <span>WhatsApp Direct Message</span>\n            </a>\n          </div>\n        </div>\n      )}\n    </header>"
    }
