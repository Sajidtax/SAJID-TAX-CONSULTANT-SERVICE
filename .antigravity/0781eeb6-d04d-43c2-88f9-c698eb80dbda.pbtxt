        lines {
          text: "export const FAQS = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    q: \"How quickly can you file my Income Tax Return (ITR)?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    a: \"Once you share your Form 16, bank statements, and PAN/Aadhaar details, our team prepares the computation and files your return within 24 to 48 hours, providing instant e-filing acknowledgement.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    q: \"Is Gumasta license mandatory for a new business in Mumbai?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    a: \"Yes. In Maharashtra, under the Maharashtra Shops and Establishments Act, any commercial establishment or office must obtain either an Intimation or a Registration certificate. It is also required by banks to open your current account.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    q: \"My PF claim was rejected by EPFO. Can you help resolve it?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    a: \"Absolutely. We specialize in fixing common PF rejection reasons like KYC mismatch, missing Date of Exit, name spelling errors, or bank account issues. We re-apply with corrected documents and track the claim until money is credited.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    q: \"Do I need to visit your Opera House office physically?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    a: \"You are always welcome to visit our office in Opera House, Mumbai during working hours (11:00 AM to 7:00 PM, Mon\342\200\223Sat). However, we also provide 100% digital service via WhatsApp and Email for your convenience.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    q: \"What are the penalty consequences for late GST or TDS filing?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    a: \"Late GST filing incurs daily late fees plus 18% per annum interest on unpaid tax liability. Delayed TDS payments attract 1.5% interest per month and late filing fees of \342\202\271200/day. We ensure all your due dates are mapped so you never pay penalties.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
