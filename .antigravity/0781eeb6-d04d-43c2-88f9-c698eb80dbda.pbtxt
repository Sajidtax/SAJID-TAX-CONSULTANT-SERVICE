et Directions (Google Maps)</span>\n              </a>\n\n              <a\n                href={`tel:${BUSINESS_INFO.phoneClean}`}\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 rounded border border-[#0D1E38]/20 bg-white hover:bg-gray-50 text-[#0D1E38] font-semibold text-xs sm:text-sm transition-all\"\n              >\n                <Phone className=\"w-4 h-4 text-[#9B2C2C]\" />\n                <span>Call: {BUSINESS_INFO.phone}</span>\n              </a>\n            </div>\n\n            {/* Digital UPI Payment Details from Screenshot */}\n            <div className=\"pt-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50/80 p-4 rounded border border-gray-200\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded bg-white border border-gray-200 flex items-center justify-center text-[#0D1E38] shrink-0\">\n                  <QrCode className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"text-[10px] font-mono uppercase text-gray-500 font-bold\">\n                    Official Consultation UPI ID\n                  </div>\n                  <div className=\"font-mono text-xs sm:text-sm font-bold text-[#0D1E38]\">\n                    {BUSINESS_INFO.upiId}\n                  </div>\n                </div>\n              </div>\n\n              <button\n                onClick={handleCopyUpi}\n                className=\"inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded bg-white border border-gray-300 text-xs font-mono font-semibold hover:bg-gray-100 text-gray-700 transition-all self-start sm:self-auto\"\n              >\n                {copiedUpi ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span className=\"text-emerald-600\">UPI Copied</span>\n                  </>\n                ) : (\n