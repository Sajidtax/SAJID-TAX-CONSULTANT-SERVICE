    replacement_chunks {
      target_content: "  return (\n    <section id=\"contact\" className=\"py-20 bg-[#ECE8DD]/60 border-t border-[#0D1E38]/10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#9B2C2C] tracking-widest\">\n            <span className=\"w-6 h-[1.5px] bg-[#9B2C2C]\"></span>\n            <span>Get In Touch</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#0D1E38] tracking-tight\">\n            Let&apos;s sort your compliance out today.\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#3A4354] leading-relaxed\">\n            Reach Consultant Sajid directly via phone, WhatsApp, email, or request a callback using the form below.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10\">\n          \n          {/* Left Column: Direct Contact Information */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            \n            <div className=\"bg-white rounded-lg border border-[#0D1E38]/15 p-6 sm:p-7 shadow-sm space-y-5\">\n              <h3 className=\"font-display font-bold text-xl text-[#0D1E38]\">\n                Direct Contact Points\n              </h3>\n\n              {/* Phone Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#F6F4EE] border border-[#0D1E38]/10\">\n                <div className=\"w-9 h-9 rounded bg-[#9B2C2C] text-white flex items-center justify-center shrink-0\">\n                  <Phone className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-gray-500\">\n                    Phone &amp; Direct Call\n                  </div>\n                  <a\n                    href={`tel:${BUSINESS_INFO.phoneClean}`}\n                    className=\"font-mono font-bold text-base text-[#0D1E38] hover:text-[#9B2C2C] transition-colors block\"\n                  >\n                    {BUSINESS_INFO.phone}\n                  </a>\n                  <p className=\"text-[11px] text-gray-500\">Available Mon\342\200\223Sat: 11 AM \342\200\223 7 PM</p>\n                </div>\n              </div>\n\n              {/* WhatsApp Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#195E3E]/5 border border-[#195E3E]/20\">\n                <div className=\"w-9 h-9 rounded bg-[#195E3E] text-white flex items-center justify-center shrink-0\">\n                  <MessageSquare className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-[#195E3E]\">\n                    WhatsApp Chat Support\n                  </div>\n                  <a\n                    href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20tax%20advice.`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"font-mono font-bold text-base text-[#195E3E] hover:underline block\"\n                  >\n                    +91 {BUSINESS_INFO.phone}\n                  </a>\n                  <p className=\"text-[11px] text-gray-500\">Quick document sharing &amp; chat</p>\n                </div>\n              </div>\n\n              {/* Email Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#F6F4EE] border border-[#0D1E38]/10\">\n                <div className=\"w-9 h-9 rounded bg-[#0D1E38] text-white flex items-center justify-center shrink-0\">\n                  <Mail className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-gray-500\">\n                    Official Email\n                  </div>\n                  <a\n                    href={`mailto:${BUSINESS_INFO.email}`}\n                    className=\"font-mono font-bold text-sm sm:text-base text-[#0D1E38] hover:text-[#9B2C2C] transition-colors break-all block\"\n                  >\n                    {BUSINESS_INFO.email}\n                  </a>\n                  <p className=\"text-[11px] text-gray-500\">Send files, forms, and enquiries</p>\n                </div>\n              </div>\n\n              {/* Office Address Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#F6F4EE] border border-[#0D1E38]/10\">\n                <div className=\"w-9 h-9 rounded bg-[#B68A2E] text-white flex items-center justify-center shrink-0\">\n                  <MapPin className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5 text-xs text-[#192231]\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-gray-500\">\n                    Office Location\n                  </div>\n                  <p className=\"font-semibold text-[#0D1E38]\">{BUSINESS_INFO.address.line1}</p>\n                  <p>{BUSINESS_INFO.address.line2}, {BUSINESS_INFO.address.area} - {BUSINESS_INFO.address.pincode}</p>\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n\n          {/* Right Column: Callback & Consultation Request Form */}\n          <div className=\"lg:col-span-7\">\n            <div className=\"bg-white rounded-lg border border-[#0D1E38]/15 p-6 sm:p-8 shadow-md\">\n              <div className=\"border-b border-gray-100 pb-4 mb-6\">\n                <h3 className=\"font-display font-bold text-2xl text-[#0D1E38]\">\n                  Request a Free Callback\n                </h3>\n                <p className=\"text-xs sm:text-sm text-gray-600 mt-1\">\n                  Fill in your requirements. Consultant Sajid will review and contact you promptly.\n                </p>\n              </div>\n\n              {submitted ? (\n                <div className=\"bg-emerald-50 border border-emerald-200 rounded-lg p-6 text-center space-y-4 animate-in fade-in\">\n                  <div className=\"w-12 h-12 rounded-full bg-emerald-100 text-[#195E3E] flex items-center justify-center mx-auto\">\n                    <CheckCircle2 className=\"w-7 h-7\" />\n                  </div>\n                  <h4 className=\"text-xl font-display font-bold text-[#0D1E38]\">\n                    Consultation Request Received!\n                  </h4>\n                  <p className=\"text-xs sm:text-sm text-[#3A4354] max-w-md mx-auto leading-relaxed\">\n                    Thank you, <strong>{formData.name || \'Valued Client\'}</strong>. We have logged your request for <strong>{formData.service}</strong>. We will call you at <strong>{formData.phone}</strong> shortly during business hours (11:00 AM \342\200\223 7:00 PM).\n                  </p>\n                  <div className=\"pt-2 flex flex-col sm:flex-row justify-center gap-3\">\n                    <button\n                      onClick={handleSendViaWhatsApp}\n                      className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded bg-[#195E3E] text-white text-xs font-semibold hover:bg-[#144b31] transition-all\"\n                    >\n                      <MessageSquare className=\"w-4 h-4\" />\n                      <span>Also Send Directly on WhatsApp</span>\n                    </button>\n                    <button\n                      onClick={() => setSubmitted(false)}\n                      className=\"text-xs text-gray-600 underline hover:text-gray-900 py-2\"\n                    >\n                      Submit another inquiry\n                    </button>\n                  </div>\n                </div>\n              ) : (\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-gray-700 mb-1.5\">\n                      Your Full Name <span className=\"text-[#9B2C2C]\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g. Rahul Sharma / Business Name\"\n                      value={formData.name}\n                      onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0D1E38] bg-[#F6F4EE]/50\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-gray-700 mb-1.5\">\n                      Mobile / Phone Number <span className=\"text-[#9B2C2C]\">*</span>\n                    </label>\n                    <input\n                      type=\"tel\"\n                      required\n                      placeholder=\"e.g. +91 98765 43210\"\n                      value={formData.phone}\n                      onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0D1E38] bg-[#F6F4EE]/50\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-gray-700 mb-1.5\">\n                      Service Required <span className=\"text-[#9B2C2C]\">*</span>\n                    </label>\n                    <select\n                      value={formData.service}\n                      onChange={(e) => setFormData({ ...formData, service: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0D1E38] bg-white\"\n                    >\n                      {SERVICES_LIST.map((srv) => (\n                        <option key={srv.id} value={srv.title}>\n                          {srv.number}. {srv.title}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-gray-700 mb-1.5\">\n                      Brief Message or Specific Query (Optional)\n                    </label>\n                    <textarea\n                      rows={3}\n                      placeholder=\"Describe your requirement (e.g. Need urgent GST registration for my new shop, or previous year ITR filing)...\"\n                      value={formData.message}\n                      onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0D1E38] bg-[#F6F4EE]/50 resize-none\"\n                    ></textarea>\n                  </div>\n\n                  <div className=\"pt-2 flex flex-col sm:flex-row gap-3\">\n                    <button\n                      type=\"submit\"\n                      className=\"flex-1 py-3 px-5 rounded bg-[#9B2C2C] hover:bg-[#822424] text-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 transition-all shadow-[2px_2px_0px_#0D1E38]\"\n                    >\n                      <Send className=\"w-4 h-4\" />\n                      <span>Request Callback</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={handleSendViaWhatsApp}\n                      className=\"py-3 px-5 rounded bg-[#195E3E] hover:bg-[#144b31] text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all\"\n                    >\n                      <MessageSquare className=\"w-4 h-4\" />\n                      <span>WhatsApp Directly</span>\n                    </button>\n                  </div>\n\n                  <p className=\"text-[11px] text-gray-500 font-mono text-center pt-2\">\n                    \360\237\224\222 100% Client Data Confidentiality Assured. We do not share your contact details.\n                  </p>\n                </form>\n              )}\n\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );"
      replacement_content: "  return (\n    <section id=\"contact\" className=\"py-20 bg-[#0A0A0A] border-t border-[#ffffff12]\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-2xl mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#D4AF37] tracking-widest\">\n            <span className=\"w-6 h-[1.5px] bg-[#D4AF37]\"></span>\n            <span>Get In Touch</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-display font-bold text-[#F5F2ED] tracking-tight\">\n            Let&apos;s sort your compliance out today.\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#A3A3A3] leading-relaxed\">\n            Reach Consultant Sajid directly via phone, WhatsApp, email, or request a callback using the form below.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10\">\n          \n          {/* Left Column: Direct Contact Information */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            \n            <div className=\"bg-[#141414] rounded-lg border border-[#ffffff15] p-6 sm:p-7 shadow-xl space-y-5\">\n              <h3 className=\"font-display font-bold text-xl text-[#F5F2ED]\">\n                Direct Contact Points\n              </h3>\n\n              {/* Phone Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#1A1A1A] border border-[#ffffff12]\">\n                <div className=\"w-9 h-9 rounded bg-[#D4AF37] text-[#0A0A0A] flex items-center justify-center shrink-0 font-bold\">\n                  <Phone className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-[#A3A3A3]\">\n                    Phone &amp; Direct Call\n                  </div>\n                  <a\n                    href={`tel:${BUSINESS_INFO.phoneClean}`}\n                    className=\"font-mono font-bold text-base text-[#F5F2ED] hover:text-[#D4AF37] transition-colors block\"\n                  >\n                    {BUSINESS_INFO.phone}\n                  </a>\n                  <p className=\"text-[11px] text-[#737373]\">Available Mon\342\200\223Sat: 11 AM \342\200\223 7 PM</p>\n                </div>\n              </div>\n\n              {/* WhatsApp Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#1A1A1A] border border-[#195E3E]/40\">\n                <div className=\"w-9 h-9 rounded bg-[#195E3E] text-white flex items-center justify-center shrink-0\">\n                  <MessageSquare className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-emerald-400\">\n                    WhatsApp Chat Support\n                  </div>\n                  <a\n                    href={`https://wa.me/${BUSINESS_INFO.phoneClean.replace(\'+\', \'\')}?text=Hello%20Sajid%20Tax%20Consultant,%20I%20need%20tax%20advice.`}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"font-mono font-bold text-base text-emerald-400 hover:underline block\"\n                  >\n                    +91 {BUSINESS_INFO.phone}\n                  </a>\n                  <p className=\"text-[11px] text-[#737373]\">Quick document sharing &amp; chat</p>\n                </div>\n              </div>\n\n              {/* Email Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#1A1A1A] border border-[#ffffff12]\">\n                <div className=\"w-9 h-9 rounded bg-[#262626] border border-[#D4AF37]/30 text-[#D4AF37] flex items-center justify-center shrink-0\">\n                  <Mail className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-[#A3A3A3]\">\n                    Official Email\n                  </div>\n                  <a\n                    href={`mailto:${BUSINESS_INFO.email}`}\n                    className=\"font-mono font-bold text-sm sm:text-base text-[#F5F2ED] hover:text-[#D4AF37] transition-colors break-all block\"\n                  >\n                    {BUSINESS_INFO.email}\n                  </a>\n                  <p className=\"text-[11px] text-[#737373]\">Send files, forms, and enquiries</p>\n                </div>\n              </div>\n\n              {/* Office Address Card */}\n              <div className=\"flex items-start gap-4 p-3.5 rounded bg-[#1A1A1A] border border-[#ffffff12]\">\n                <div className=\"w-9 h-9 rounded bg-[#262626] border border-[#D4AF37]/30 text-[#D4AF37] flex items-center justify-center shrink-0\">\n                  <MapPin className=\"w-4 h-4\" />\n                </div>\n                <div className=\"space-y-0.5 text-xs text-[#D4D4D4]\">\n                  <div className=\"font-mono text-[10px] uppercase font-bold text-[#A3A3A3]\">\n                    Office Location\n                  </div>\n                  <p className=\"font-semibold text-[#F5F2ED]\">{BUSINESS_INFO.address.line1}</p>\n                  <p>{BUSINESS_INFO.address.line2}, {BUSINESS_INFO.address.area} - {BUSINESS_INFO.address.pincode}</p>\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n\n          {/* Right Column: Callback & Consultation Request Form */}\n          <div className=\"lg:col-span-7\">\n            <div className=\"bg-[#141414] rounded-lg border border-[#ffffff15] p-6 sm:p-8 shadow-xl\">\n              <div className=\"border-b border-[#ffffff12] pb-4 mb-6\">\n                <h3 className=\"font-display font-bold text-2xl text-[#F5F2ED]\">\n                  Request a Free Callback\n                </h3>\n                <p className=\"text-xs sm:text-sm text-[#A3A3A3] mt-1\">\n                  Fill in your requirements. Consultant Sajid will review and contact you promptly.\n                </p>\n              </div>\n\n              {submitted ? (\n                <div className=\"bg-[#1A1A1A] border border-emerald-500/40 rounded-lg p-6 text-center space-y-4 animate-in fade-in\">\n                  <div className=\"w-12 h-12 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto\">\n                    <CheckCircle2 className=\"w-7 h-7\" />\n                  </div>\n                  <h4 className=\"text-xl font-display font-bold text-[#F5F2ED]\">\n                    Consultation Request Received!\n                  </h4>\n                  <p className=\"text-xs sm:text-sm text-[#D4D4D4] max-w-md mx-auto leading-relaxed\">\n                    Thank you, <strong>{formData.name || \'Valued Client\'}</strong>. We have logged your request for <strong>{formData.service}</strong>. We will call you at <strong>{formData.phone}</strong> shortly during business hours (11:00 AM \342\200\223 7:00 PM).\n                  </p>\n                  <div className=\"pt-2 flex flex-col sm:flex-row justify-center gap-3\">\n                    <button\n                      onClick={handleSendViaWhatsApp}\n                      className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded bg-[#195E3E] text-white text-xs font-semibold hover:bg-[#1e734c] transition-all\"\n                    >\n                      <MessageSquare className=\"w-4 h-4\" />\n                      <span>Also Send Directly on WhatsApp</span>\n                    </button>\n                    <button\n                      onClick={() => setSubmitted(false)}\n                      className=\"text-xs text-[#A3A3A3] underline hover:text-[#F5F2ED] py-2\"\n                    >\n                      Submit another inquiry\n                    </button>\n                  </div>\n                </div>\n              ) : (\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-[#D4D4D4] mb-1.5\">\n                      Your Full Name <span className=\"text-[#D4AF37]\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"e.g. Rahul Sharma / Business Name\"\n                      value={formData.name}\n                      onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-[#ffffff18] text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-[#171717] text-[#F5F2ED] placeholder:text-[#737373]\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-[#D4D4D4] mb-1.5\">\n                      Mobile / Phone Number <span className=\"text-[#D4AF37]\">*</span>\n                    </label>\n                    <input\n                      type=\"tel\"\n                      required\n                      placeholder=\"e.g. +91 98765 43210\"\n                      value={formData.phone}\n                      onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-[#ffffff18] text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-[#171717] text-[#F5F2ED] placeholder:text-[#737373]\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-[#D4D4D4] mb-1.5\">\n                      Service Required <span className=\"text-[#D4AF37]\">*</span>\n                    </label>\n                    <select\n                      value={formData.service}\n                      onChange={(e) => setFormData({ ...formData, service: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-[#ffffff18] text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-[#171717] text-[#F5F2ED]\"\n                    >\n                      {SERVICES_LIST.map((srv) => (\n                        <option key={srv.id} value={srv.title} className=\"bg-[#171717] text-[#F5F2ED]\">\n                          {srv.number}. {srv.title}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-mono font-bold uppercase text-[#D4D4D4] mb-1.5\">\n                      Brief Message or Specific Query (Optional)\n                    </label>\n                    <textarea\n                      rows={3}\n                      placeholder=\"Describe your requirement (e.g. Need urgent GST registration for my new shop, or previous year ITR filing)...\"\n                      value={formData.message}\n                      onChange={(e) => setFormData({ ...formData, message: e.target.value })}\n                      className=\"w-full px-3.5 py-2.5 rounded border border-[#ffffff18] text-sm focus:outline-none focus:border-[#D4AF37] focus:ring-1 focus:ring-[#D4AF37] bg-[#171717] text-[#F5F2ED] placeholder:text-[#737373] resize-none\"\n                    ></textarea>\n                  </div>\n\n                  <div className=\"pt-2 flex flex-col sm:flex-row gap-3\">\n                    <button\n                      type=\"submit\"\n                      className=\"flex-1 py-3 px-5 rounded bg-[#D4AF37] hover:bg-[#E5C158] text-[#0A0A0A] font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 transition-all shadow-[2px_2px_0px_rgba(255,255,255,0.15)]\"\n                    >\n                      <Send className=\"w-4 h-4\" />\n                      <span>Request Callback</span>\n                    </button>\n\n                    <button\n                      type=\"button\"\n                      onClick={handleSendViaWhatsApp}\n                      className=\"py-3 px-5 rounded bg-[#195E3E] hover:bg-[#1e734c] text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all\"\n                    >\n                      <MessageSquare className=\"w-4 h-4\" />\n                      <span>WhatsApp Directly</span>\n                    </button>\n                  </div>\n\n                  <p className=\"text-[11px] text-[#737373] font-mono text-center pt-2\">\n                    \360\237\224\222 100% Client Data Confidentiality Assured. We do not share your contact details.\n                  </p>\n                </form>\n              )}\n\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );"
    }
